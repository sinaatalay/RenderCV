{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python \"$CLAUDE_PROJECT_DIR/scripts/guardrails/pre_tool_guard.py\"",
                        "timeout": 30,
                        "statusMessage": "Guardrail check..."
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"$CLAUDE_PROJECT_DIR\" && just check",
                        "timeout": 120,
                        "statusMessage": "Running just check..."
                    }
                ]
            }
        ]
    }
}
