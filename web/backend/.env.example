# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# Then run the backend with `uv run --env-file .env uvicorn ...`.
# `.env` is gitignored; this template is not, and must never hold real values.
#
# The Google pair at the bottom is required: the editor only opens for a
# signed-in account, so without it nobody can get in. Everything else has a
# working local default.

# --- Sessions -----------------------------------------------------------

# Signs the session cookie. The fallback is a hardcoded string in a public
# repository, so anyone can forge a validly signed cookie and read other
# people's CVs. REQUIRED before any deployment; the server only warns.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
RENDERCV_WEB_SECRET=

# Set to 1 when serving over HTTPS, so the session cookie is marked `Secure`.
# Leave unset for local http://localhost, where a Secure cookie is never sent.
RENDERCV_WEB_HTTPS=

# --- Database -----------------------------------------------------------

# Any SQLAlchemy URL. Unset means SQLite at ./data/rendercv_web.db, which a
# container loses on every restart. Postgres needs `uv sync --extra postgres`;
# `postgres://`, `postgresql://` and `postgresql+psycopg://` are all accepted.
RENDERCV_WEB_DATABASE_URL=

# --- CORS ---------------------------------------------------------------

# Comma-separated frontend origins allowed to call this API. Only needed when
# the frontend is served from a different origin than the API; leave unset
# behind a reverse proxy that puts /api on the app's own host. Getting this
# wrong looks like the page loading fine while sign-in and saving silently
# fail, with only a CORS error in the browser console.
RENDERCV_WEB_ALLOWED_ORIGINS=

# --- Google sign-in (required) ------------------------------------------

# REQUIRED. From Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Left blank, the server reports the
# provider as unavailable and /app says so plainly instead of showing a dead
# button -- but the editor cannot be entered by anyone.
# See docs/runbooks/enable-google-sign-in-and-postgres.md for the full walk-through.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must match an Authorized redirect URI on the OAuth client exactly, including
# scheme and port, with no trailing slash. Defaults to the dev server's:
#     http://localhost:5173/api/auth/google/callback
# A deployment sets its own:
#     https://<your-domain>/api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
